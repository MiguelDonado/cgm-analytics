# Template for cgm-db.env, read by the cgm-db container (env_file in
# docker-compose.override.yml). Copy it and fill in the password:
#   cp cgm-db.env.example cgm-db.env
#
# Read by the Postgres image to create the superuser and the database, ONLY on
# the first start (empty data volume). Changing them later does nothing.
POSTGRES_USER=cgm
POSTGRES_DB=cgm
# Must match CGM_DB_PASSWORD in dashboard/.env and the password in
# AIRFLOW_CONN_CGM_DB in .env.
POSTGRES_PASSWORD=change-me