# Template for .env, passed by the Astro CLI to every Airflow container. Copy it
# and fill in your credentials:
#   cp .env.example .env
#
# See docs/airflow-setup.md for how these connections work.

# Connection cgm_db: postgresql://user:password@host:port/database
# Host and port are the Docker network ones (cgm-db:5432), not localhost:5433.
# The password must match POSTGRES_PASSWORD in cgm-db.env.
AIRFLOW_CONN_CGM_DB='postgresql://cgm:change-me@cgm-db:5432/cgm'

# Connection librelinkup: your LibreLinkUp follower account.
# JSON, so the email and password go in as they are, without URL-encoding.
AIRFLOW_CONN_LIBRELINKUP='{"conn_type": "generic", "login": "you@example.com", "password": "your-password"}'
