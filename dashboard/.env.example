# Template for dashboard/.env, read by the dashboard container (env_file in
# docker-compose.override.yml). Copy it and fill in the password:
#   cp dashboard/.env.example dashboard/.env
#
# Connection to cgm-db from inside the Docker network (not localhost:5433).
CGM_DB_HOST=cgm-db
CGM_DB_PORT=5432
CGM_DB_NAME=cgm
CGM_DB_USER=cgm
# Must match POSTGRES_PASSWORD of the cgm-db service.
CGM_DB_PASSWORD=change-me